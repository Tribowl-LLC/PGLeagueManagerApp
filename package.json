  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  },
  "overrides": {
    "axios": "^1.18.1",
    "picomatch@2": "^2.3.2",
    "picomatch@4": "^4.0.4",
    "lodash": "^4.18.1",
    "@xmldom/xmldom@0.8": "^0.8.12",
