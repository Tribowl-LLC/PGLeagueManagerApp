{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:migration-bytes:check": "tsx scripts/check-migration-bytes.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:fingerprint": "tsx scripts/db-fingerprint.ts",
    "db:adopt-baseline:preflight": "tsx scripts/db-adopt-baseline-preflight.ts",
    "db:adopt-baseline": "tsx scripts/db-adopt-baseline.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:audit:organization-hostnames": "tsx scripts/audit-organization-hostname-collisions.ts",
    "db:preflight:identity-integrity": "tsx scripts/identity-integrity-preflight.ts",
    "db:migrate:legacy-account-actions": "tsx scripts/migrate-legacy-account-actions.ts",
    "db:inventory": "tsx scripts/db-inventory.ts",
    "db:inventory:compare": "tsx scripts/db-inventory-compare.ts",
    "db:inventory:validate-local": "tsx scripts/db-inventory-validate-local.ts",
    "db:push:disposable": "tsx scripts/db-push-disposable.ts",
    "test:template:build": "tsx scripts/build-test-template.ts",
    "test": "vitest run",
    "test:local": "tsx scripts/test-local.ts",
    "test:unit-no-db": "vitest run --project unit-no-db",
    "test:watch": "vitest",
    "test:race": "bash scripts/test-race.sh",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=moderate",
    "check:csrf": "tsx scripts/check-csrf-coverage.ts",
    "check:org-isolation": "tsx scripts/check-org-isolation-coverage.ts --strict",
    "snapshot:failures": "bash scripts/snapshot-failures.sh"
  },
