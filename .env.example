# Copy the variables you need into your shell or local secret manager.
# `npm run dev` does not automatically load this file or a local `.env` file.
# Values below are placeholders for local development only. Never use
# production credentials or commit a populated environment file.

# Required application settings (server-only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/leaguevault
SESSION_SECRET=replace-with-a-long-random-local-development-secret
# Exactly 64 hexadecimal characters. Generate a local value using the command
# documented in README.md; do not reuse a production encryption key.
FIELD_ENCRYPTION_KEY=
# Required explicitly in production. Phase 2B-1 ships dormant; use
# `ledger_paused` for its production verification deploy. Local development
# may use `legacy`. Never select `ledger_execute` before Phase 2B-2 is merged.
SCHEDULED_PAYMENT_EXECUTION_MODE=legacy
# F3 canonical policy/plan setup remains disabled unless explicitly approved.
# This does not enable F1 or change existing v1 schedules.
LEAGUEVAULT_F3_CANONICAL_AUTOPAY_ENABLED=false
LEAGUEVAULT_F4_CANONICAL_AUTOPAY_EXECUTION_ENABLED=false

# Application runtime (optional, server-only)
APP_ENV=dev
NODE_ENV=development
APP_DOMAIN=leaguevault.app
PORT=5000
LOG_LEVEL=debug

# Email and error monitoring (optional, server-only)
SENDGRID_API_KEY=
SENTRY_DSN=
# Build-only credential for uploading browser source maps. Never prefix this
# secret with VITE_ or expose it to browser code.
SENTRY_AUTH_TOKEN=
# Optional overrides; production defaults to the current Sentry slugs.
SENTRY_ORG=perfect-game
SENTRY_PROJECT=javascript-react
# Fraction of backend requests traced (0 to 1). Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Comma-separated denylist; defaults to vitest.local when omitted.
BLOCK_EMAIL_DOMAINS=vitest.local

# Browser error monitoring (optional, browser-visible)
# Every VITE_ value is bundled into browser code. Never put a secret here.
VITE_SENTRY_DSN=

# Admin bootstrap (optional, server-only)
# When set, this must be at least 32 non-repeating characters.
SETUP_SECRET=

# Square sandbox integration (optional)
# Access tokens are server-only secrets.
SQUARE_ACCESS_TOKEN=
# Application and location IDs are identifiers, not secrets.
SQUARE_APP_ID=
SQUARE_LOCATION_ID=
# VITE_ identifiers are browser-visible and must never contain credentials.
VITE_SQUARE_APP_ID=
VITE_SQUARE_LOCATION_ID=

# Square webhook ingestion (optional, server-only; defaults disabled)
# Keep processing disabled until the migration-first activation runbook is
# complete. `ingest_only` records evidence only; `reconcile_payments` may
# finalize conclusively COMPLETED known payment/refund operations. The
# separate `reconcile_payments_and_disputes` mode also records independently
# mapped dispute lifecycle state.
SQUARE_WEBHOOK_MODE=disabled
# Exact subscription URL; signatures fail if scheme, host, path, query, or
# trailing slash differs. Production uses the apex leaguevault.app domain.
SQUARE_WEBHOOK_NOTIFICATION_URL=
SQUARE_WEBHOOK_API_VERSION=2026-05-20
# JSON array of application-owned subscription secrets. Placeholder shape:
# [{"applicationId":"sandbox-app-id","signatureKey":"local-test-key-only"}]
SQUARE_WEBHOOK_SIGNATURE_KEYS_JSON=

# Apple Pay domain verification and operational alerts (optional, server-only)
APPLE_PAY_DOMAIN_VERIFICATION=
APPLE_PAY_RECOVERY_ALERTS_ENABLED=false
APPLE_PAY_RECOVERY_ALERT_MIN_INTERVAL_MS=1800000
SQUARE_CATALOG_CAP_ALERTS_ENABLED=false
SQUARE_CATALOG_CAP_ALERT_MIN_INTERVAL_MS=21600000
